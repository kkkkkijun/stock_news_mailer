# Kafka 브로커 주소 (host:port)
KAFKA_BOOTSTRAP=localhost:9092

# 시세 틱을 주고받는 토픽 이름
KAFKA_TOPIC=market.ticks

# producer.py의 Hyperliquid allMids 폴링 주기(초)
POLL_INTERVAL=2.0

# consumer.py의 Kafka consumer group id
GROUP_ID=market-agg

# consumer.py가 스냅샷을 다시 쓰는 주기(초)
FLUSH_INTERVAL=5.0

# 집계 스냅샷 JSON 출력 경로
OUT_PATH=streaming/out/stream.json
