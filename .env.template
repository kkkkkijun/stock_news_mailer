# =========================================================
# 필수
# =========================================================
# OpenAI API 키 (뉴스 요약·정성 분석 등에 사용). 기본값 없음 — 반드시 설정.
OPENAI_API_KEY=your_openai_api_key_here

# =========================================================
# 알림 (앱 푸시 · 선택 이메일)
# =========================================================
# 웹 푸시용 VAPID 비공개키(PEM). 없으면 푸시는 조용히 건너뜀.
VAPID_PRIVATE_KEY=your_vapid_private_key_pem_here
# VAPID 클레임의 연락처(mailto:...). 기본값: mailto:admin@example.com
VAPID_SUBJECT=mailto:admin@example.com
# 브리핑 알림에 넣을 사이트 URL. 기본값: https://kkkkkijun.github.io/stock_news_mailer/
SITE_URL=https://kkkkkijun.github.io/stock_news_mailer/
# 1이면 앱 푸시 외에 이메일도 발송(선택, 기본 꺼짐=0)
SEND_EMAIL=0
# 이메일 발신 계정(Gmail) — SEND_EMAIL=1 일 때만 사용. 기본값 없음.
EMAIL_USER=your_email_here
# Gmail 앱 비밀번호 — SEND_EMAIL=1 일 때만 사용. 기본값 없음.
EMAIL_PASS=your_app_password_here
# 이메일 수신자(콤마 구분) — SEND_EMAIL=1 일 때만 사용.
# 기본값: seo930714@gmail.com,mjikshouse@naver.com
EMAIL_RECIPIENTS=seo930714@gmail.com,mjikshouse@naver.com

# =========================================================
# 파이프라인 옵션 (선택, 대부분 기본값 있음)
# =========================================================
# 웹사이트(docs/index.html) 발행 여부. 0이면 건너뜀. 기본값: 1
PUBLISH_SITE=1
# 발송/발행 없이 본문만 콘솔 출력(테스트용). 1이면 활성화. 기본값 없음(꺼짐)
DRY_RUN=0
# 요약에 쓰는 OpenAI 모델. 기본값: gpt-4o-mini
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# 요약 응답의 최대 토큰 수. 기본값: 500
OPENAI_SUMMARY_MAX_TOKENS=500
# 추적할 주식 티커(콤마 구분). 기본값: NVDA,TSLA,HIMS,RDW,IREN,RKLB
STOCK_TICKERS=NVDA,TSLA,HIMS,RDW,IREN,RKLB
# 추적할 코인 티커(콤마 구분). 기본값: BTC-USD,ETH-USD,SOL-USD,BMNR
CRYPTO_TICKERS=BTC-USD,ETH-USD,SOL-USD,BMNR
# 티커별 최대 뉴스 개수. 기본값: 3
NEWS_PER_TICKER=3
# 기사 원문 본문을 붙여 2단계 요약에 쓸지 여부(1=사용). 기본값: 1
USE_ARTICLE_BODIES=1
# 기사 원문에서 잘라 쓸 최대 글자 수. 기본값: 1500
ARTICLE_BODY_CHARS=1500
# 기사 원문 요청 타임아웃(초). 기본값: 12
ARTICLE_FETCH_TIMEOUT=12
# 부동산 브리핑에 담을 최대 항목 수. 기본값: 6
REALESTATE_TOP_N=6
# 부동산 브리핑 쿼리당 후보 풀 크기. 기본값: 30
REALESTATE_POOL_PER_QUERY=30
# 토픽 브리핑에 담을 최대 항목 수. 기본값: 5
TOPIC_TOP_N=5
# 토픽 브리핑 쿼리당 후보 풀 크기. 기본값: 30
TOPIC_POOL_PER_QUERY=30
# 트럼프 브리핑 RSS 피드 URL. 기본값: https://trumpstruth.org/feed
TRUMP_FEED_URL=https://trumpstruth.org/feed
# 트럼프 브리핑에서 훑어볼 최대 게시물 수. 기본값: 25
TRUMP_MAX_POSTS=25
# 트럼프 브리핑에 담을 최대 항목 수. 기본값: 6
TRUMP_TOP_N=6
# 트럼프 브리핑에 반영할 게시물의 최대 경과 시간(시간 단위). 기본값: 24
TRUMP_MAX_AGE_HOURS=24
# (Airflow 전용) 파이프라인 저장소 경로. 기본값: /opt/airflow/repo
PIPELINE_REPO=/opt/airflow/repo
