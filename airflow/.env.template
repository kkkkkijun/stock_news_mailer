# Copy this file to .env in the same directory (airflow/.env) and fill
# in real values before running `docker compose up -d`.
#
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real secrets.

# ---- Airflow UI login (REQUIRED before exposing the UI) ----
# airflow-init creates this admin account. Do NOT leave a weak password
# if the UI will be reachable from outside (Airflow runs arbitrary code).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Random secret for web session signing (any long random string).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-to-a-random-hex-string

# ---- Pipeline secrets (used by the DAG tasks) ----
# OpenAI API key used by main.py / fundamentals.py for report/qualitative generation
OPENAI_API_KEY=sk-your-openai-api-key-here

# Web Push (VAPID) credentials used by push_send.py
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:you@example.com

# Public site URL used in push notification deep links
SITE_URL=https://kkkkkijun.github.io/stock_news_mailer/

# Feature toggles read by the pipeline modules
PUBLISH_SITE=1
SEND_EMAIL=0
